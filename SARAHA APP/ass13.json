                  "const res = pm.response.json();",
                  "const token = res.token || res.data?.token || res.accessToken || res.data?.accessToken;",
                  "if (token) {",
                  "    pm.collectionVariables.set(\"authToken\", token);",
                  "    console.log(\"Token saved to authToken variable\");",
                  "} else {",
